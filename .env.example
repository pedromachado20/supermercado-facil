DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/supermercado-facil?sslmode=require
BETTER_AUTH_SECRET=gere-um-secret-aleatorio-aqui
BETTER_AUTH_URL=http://localhost:3000
# IA para extração de produtos (configure ao menos uma)
GOOGLE_AI_API_KEY=          # gratuito — obtenha em aistudio.google.com/apikey
ANTHROPIC_API_KEY=sk-ant-xxx # pago — opcional, fallback do Gemini
# Google OAuth (opcional — habilita o botão "Entrar com Google")
# Crie em: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# URI de redirecionamento autorizado: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# E-mail transacional — obtenha em resend.com (sem isso, "esqueci minha senha" e os e-mails
# de trial/cobrança são pulados silenciosamente, só logados no console)
RESEND_API_KEY=
EMAIL_FROM=Supermercado Fácil <onboarding@nexusteck.com.br>
# Cobrança (Mercado Pago) — Suas integrações → Criar aplicação → Credenciais de produção
MP_ACCESS_TOKEN=
# Token que você define no cadastro do webhook no painel do Mercado Pago
MP_WEBHOOK_SECRET=
# Protege /api/cron/sweep — mesmo valor configurado no cron da Vercel
CRON_SECRET=
